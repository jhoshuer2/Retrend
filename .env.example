# Required
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth (Google Cloud Console → APIs & Services → Credentials).
# Needs the YouTube Data API v3 and YouTube Analytics API enabled, and
# an OAuth consent screen with the youtube.readonly and yt-analytics.readonly
# scopes added (see README).
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Optional — only needed if VERCEL_PROJECT_PRODUCTION_URL isn't set
# automatically (e.g. local dev, or a custom domain you want callbacks to use).
# APP_BASE_URL=https://your-domain.com

# Optional — defaults to claude-sonnet-5-5 if unset
CLAUDE_MODEL=claude-sonnet-5-5

# Added automatically once you connect a Postgres database (e.g. Neon,
# via the Vercel Marketplace) to this project in the Vercel dashboard
# (Storage tab) — you don't set these by hand.
# DATABASE_URL=...
